GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGO_URI="mongodb://user:password@host:27017/port?authSource=admin&serverSelectionTimeoutMS=2000"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="password"

# S3 / Garage — run scripts/init-garage.sh once to generate ACCESS_KEY + SECRET_KEY
S3_ENDPOINT="http://localhost:3900"
S3_REGION="garage"
S3_KEY_NAME="brainflex-key"
S3_BUCKET="brainflex-images"
S3_ACCESS_KEY="access_key"
S3_SECRET_KEY="secret_key"

LOGGING_LEVEL="DEBUG"